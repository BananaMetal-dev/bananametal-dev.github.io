{
  "name": "bananametal-dev.github.io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
