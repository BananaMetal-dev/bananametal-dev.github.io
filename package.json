    "lucide-react": "^1.41.0",
    "mediabunny": "1.50.8",
    "mpg123-decoder": "^1.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.0.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
